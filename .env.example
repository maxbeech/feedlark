# --- Database (Supabase Postgres via Drizzle + postgres-js) ---
# Transaction pooler (port 6543) connection string — best for serverless.
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Supabase REST (used by edge middleware for custom-domain lookup; service role is server-only).
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# 32+ char random string used to sign session JWTs. REQUIRED in production.
AUTH_SECRET=

# --- Public site URL (used for canonical links, RSS, widget origin, email links) ---
NEXT_PUBLIC_SITE_URL=https://www.feedlark.com

# --- Stripe (optional — billing degrades to 503 if unset) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_ENABLED=false
# Flip to true ONLY after activating Stripe Tax in the dashboard, else checkout errors.
STRIPE_TAX_ENABLED=false

# --- Email (Resend; optional — emails no-op if unset) ---
RESEND_API_KEY=
EMAIL_FROM=Feedlark <noreply@mail.feedlark.com>
# Svix signing secret for the Resend bounce/complaint webhook (/api/resend/webhook).
RESEND_WEBHOOK_SECRET=

# Rate limiting and error monitoring are backed by our own Supabase Postgres
# (tables rate_limits + error_events) — no external Redis/Sentry service needed.

# --- Cron (protects /api/cron/* ; Vercel injects this header automatically) ---
CRON_SECRET=

# --- AI duplicate-clustering (optional — feature hidden if unset) ---
# Any OpenAI-compatible endpoint; left blank = heuristic fallback only.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── OpenHelm Mail (transactional email) ──────────────────────────────────────
# This product sends through OpenHelm Mail, on its OWN inbox and — once its
# domain's DNS is verified — its own sending domain. Both values come from the
# product's Mail tab in ProductFactory; without them sendEmail() returns
# { sent: false, reason: "not_configured" } and never pretends to have sent.
OPENHELM_API_KEY=
OPENHELM_MAIL_INBOX_ID=
# Optional. Defaults to https://openhelm-worker.fly.dev/v1
# OPENHELM_API_URL=
# Optional display name on outbound mail (defaults to the product name).
# OPENHELM_MAIL_FROM_NAME=

# ── OpenHelm Analytics (Google Analytics 4) ──────────────────────────────────
# This product's OWN GA4 property. Unset means no measurement at all: no tag is
# loaded and no events are sent — never a half-configured tag pointing at some
# other product's property. The id lives here rather than in code so that
# re-pointing the product at a different property is a config change.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Only for surfaces that have no browser (desktop shell, mobile app, server-side
# events). NOT public — it authorises writes into the property.
# GA_API_SECRET=
# Only for a native mobile app stream, which is keyed by Firebase app id rather
# than by measurement id.
# GA_FIREBASE_APP_ID=
